+        assertThat(client.isAcceptAnyProxy()).isFalse();
+        assertThat(client.getAllowedProxyChains()).isEqualTo("https://service.example.test/proxy");
+        assertThat(client.getArtifactParameterName()).isEqualTo("serviceTicket");
